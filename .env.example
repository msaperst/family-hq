# Application port. Keep distinct from Grafana's port 3000 on the NAS.
FAMILY_HQ_PORT=3080
# Loopback for local Node development; Compose overrides this for container networking.
HOST=127.0.0.1
# Vite development server, separate from the API.
VITE_PORT=5173
# Local SQLite path; Compose uses a persistent named volume at /app/data.
FAMILY_HQ_DB_PATH=./data/family-hq.sqlite

# Example only. Keep your actual private .env.production on the NAS, out of Git.
# HTTPS reverse proxy on the NAS should connect to 127.0.0.1:3080.
FAMILY_HQ_PUBLISHED_PORT=3080
FAMILY_HQ_IMAGE=family-hq:local

# Read-only Google Calendar integration: leave all four unset for no calendar.
FAMILY_HQ_GOOGLE_CALENDAR_ID=
FAMILY_HQ_GOOGLE_CLIENT_ID=
FAMILY_HQ_GOOGLE_CLIENT_SECRET=
FAMILY_HQ_GOOGLE_REFRESH_TOKEN=
